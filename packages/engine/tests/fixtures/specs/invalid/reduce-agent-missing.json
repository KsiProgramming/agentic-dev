{
  "spec_version": "0",
  "id": "reduce-agent-missing",
  "name": "Agent strategy without an agent",
  "root": {
    "type": "sequence",
    "id": "main",
    "steps": [
      {
        "type": "map",
        "id": "each",
        "over": "[\"packages/api\", \"packages/engine\", \"web\"]",
        "body": {
          "type": "agent",
          "id": "writer",
          "role": "Writer",
          "instructions": "Describe the module named by your input."
        },
        "max_concurrency": 2
      },
      {
        "type": "reduce",
        "id": "join",
        "from": "each",
        "strategy": "agent"
      }
    ]
  }
}
