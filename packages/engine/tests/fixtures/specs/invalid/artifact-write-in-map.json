{
  "spec_version": "0",
  "id": "artifact-write-in-map",
  "name": "An artifact written once per map item",
  "root": {
    "type": "map",
    "id": "each",
    "over": "[\"packages/api\", \"web\"]",
    "body": {
      "type": "agent",
      "id": "scan",
      "role": "Reviewer",
      "instructions": "List the findings in the module named by your input.",
      "writes": "findings.json"
    },
    "max_concurrency": 2
  }
}
