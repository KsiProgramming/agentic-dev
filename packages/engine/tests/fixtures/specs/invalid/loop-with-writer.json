{
  "spec_version": "0",
  "id": "loop-with-writer",
  "name": "Writer in a loop",
  "root": {
    "type": "loop",
    "id": "revise",
    "body": {
      "type": "agent",
      "id": "writer",
      "role": "Writer",
      "instructions": "Write NOTES.md and commit it.",
      "tools": [
        "repo.write_file",
        "repo.commit"
      ]
    },
    "until": "last.contains(\"APPROVED\")",
    "max_iterations": 3
  }
}
