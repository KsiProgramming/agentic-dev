{
  "spec_version": "0",
  "id": "loop-too-many",
  "name": "Too many iterations",
  "root": {
    "type": "loop",
    "id": "revise",
    "body": {
      "type": "sequence",
      "id": "round",
      "steps": [
        {
          "type": "agent",
          "id": "draft",
          "role": "Technical writer",
          "instructions": "Write a short project summary from the input. If the input is review feedback, revise the summary to address it."
        },
        {
          "type": "agent",
          "id": "review",
          "role": "Reviewer",
          "instructions": "Review the summary. Reply APPROVED if it is clear and accurate; otherwise list what to fix."
        }
      ]
    },
    "until": "last.contains(\"APPROVED\")",
    "max_iterations": 6
  }
}
