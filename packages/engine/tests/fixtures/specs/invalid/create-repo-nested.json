{
  "spec_version": "0",
  "id": "create-repo-nested",
  "name": "Creates a repo in a nested sequence",
  "root": {
    "type": "sequence",
    "id": "main",
    "steps": [
      {
        "type": "gate",
        "id": "approve_repo",
        "title": "Create the repo?"
      },
      {
        "type": "sequence",
        "id": "inner",
        "steps": [
          {
            "type": "tool",
            "id": "create_repo",
            "tool": "github.createRepo",
            "args": {
              "name": "docs-new",
              "private": true
            }
          }
        ]
      }
    ]
  }
}
