{
  "spec_version": "0",
  "id": "artifact-read-before-write",
  "name": "A read before the artifact is written",
  "root": {
    "type": "sequence",
    "id": "main",
    "steps": [
      {
        "type": "agent",
        "id": "report",
        "role": "Writer",
        "instructions": "Write a report of the findings.",
        "reads": ["findings.json"]
      },
      {
        "type": "agent",
        "id": "scan",
        "role": "Reviewer",
        "instructions": "List the findings.",
        "writes": "findings.json"
      }
    ]
  }
}
