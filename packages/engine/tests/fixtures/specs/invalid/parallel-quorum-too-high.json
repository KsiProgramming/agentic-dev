{
  "spec_version": "0",
  "id": "parallel-quorum-too-high",
  "name": "Quorum above the branches",
  "root": {
    "type": "parallel",
    "id": "review",
    "join": "quorum",
    "quorum": 4,
    "branches": [
      {
        "type": "agent",
        "id": "security",
        "role": "Security reviewer",
        "instructions": "Review the code in your input for security problems. List each finding with a severity."
      },
      {
        "type": "agent",
        "id": "dependencies",
        "role": "Dependency reviewer",
        "instructions": "Review the dependencies named in your input for outdated or risky packages."
      },
      {
        "type": "agent",
        "id": "style",
        "role": "Style reviewer",
        "instructions": "Review the code in your input for readability and naming problems."
      }
    ]
  }
}
