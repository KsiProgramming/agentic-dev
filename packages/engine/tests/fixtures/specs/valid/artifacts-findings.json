{
  "spec_version": "0",
  "id": "artifacts-findings",
  "name": "Findings through artifacts",
  "description": "A scanner writes findings.json; a reporter reads it after an unrelated step and a gate.",
  "root": {
    "type": "sequence",
    "id": "main",
    "steps": [
      {
        "type": "agent",
        "id": "scan",
        "role": "Security reviewer",
        "instructions": "List the security findings in your input.",
        "output_schema": {
          "type": "object",
          "required": ["findings"],
          "properties": { "findings": { "type": "array" } }
        },
        "writes": "findings.json"
      },
      {
        "type": "agent",
        "id": "summary",
        "role": "Editor",
        "instructions": "Summarise your input in one paragraph."
      },
      { "type": "gate", "id": "approve", "title": "Approve the findings" },
      {
        "type": "agent",
        "id": "report",
        "role": "Writer",
        "instructions": "Write a short report of the findings in your input.",
        "tools": ["artifacts.list", "artifacts.read"],
        "reads": ["findings.json"],
        "input_schema": {
          "type": "object",
          "required": ["findings"],
          "properties": { "findings": { "type": "array" } }
        },
        "writes": "report.md"
      }
    ]
  }
}
