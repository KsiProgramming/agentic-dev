<?xml version="1.0" encoding="utf-8"?>
<!-- The only package source a .NET restore uses in the sandbox (4.8): nuget.org, through the
     NuGet egress proxy. The restore names this file as its only config, so the repo's own
     nuget.config is not read and a restore never reaches a host the platform did not allow.
     (No double hyphen may appear in an XML comment.) -->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
  <packageSourceMapping>
    <clear />
  </packageSourceMapping>
  <disabledPackageSources>
    <clear />
  </disabledPackageSources>
</configuration>
