{
  "openapi": "3.1.0",
  "info": {
    "title": "Agentic Dev Platform API",
    "version": "0.1.0"
  },
  "paths": {
    "/health": {
      "get": {
        "tags": [
          "health"
        ],
        "summary": "Health",
        "description": "Liveness: the process is up. Checks no dependencies.",
        "operationId": "getHealth",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Health"
                }
              }
            }
          }
        }
      }
    },
    "/health/ready": {
      "get": {
        "tags": [
          "health"
        ],
        "summary": "Ready",
        "description": "Readiness: Postgres and Redis both answer.",
        "operationId": "getReadiness",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Readiness"
                }
              }
            }
          },
          "503": {
            "description": "A dependency is unavailable",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Readiness"
                }
              }
            }
          }
        }
      }
    },
    "/runs": {
      "post": {
        "tags": [
          "runs"
        ],
        "summary": "Create",
        "description": "Queue a run of `workflow` with `input` for its first node, working on `repo` if given.\nStream it from `events_url`.",
        "operationId": "createRun",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateRunRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "202": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CreateRunResponse"
                }
              }
            }
          },
          "404": {
            "description": "No workspace with this id"
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/runs/{run_id}/events": {
      "get": {
        "tags": [
          "runs"
        ],
        "summary": "Stream Run Events",
        "description": "The run's events as Server-Sent Events: stored ones first, then live ones as they are\nwritten. Each frame's `id` is the event's `seq`, `event` its type and `data` the `RunEvent`.\nThe stream ends after the run's final event.",
        "operationId": "streamRunEvents",
        "parameters": [
          {
            "name": "run_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid",
              "title": "Run Id"
            }
          },
          {
            "name": "after",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "integer",
                  "minimum": 0
                },
                {
                  "type": "null"
                }
              ],
              "description": "Start after this seq (`Last-Event-ID` wins).",
              "title": "After"
            },
            "description": "Start after this seq (`Last-Event-ID` wins)."
          },
          {
            "name": "last-event-id",
            "in": "header",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "integer",
                  "minimum": 0
                },
                {
                  "type": "null"
                }
              ],
              "title": "Last-Event-Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "text/event-stream": {
                "itemSchema": {
                  "type": "object",
                  "properties": {
                    "data": {
                      "type": "string",
                      "contentMediaType": "application/json",
                      "contentSchema": {
                        "$ref": "#/components/schemas/RunEvent"
                      }
                    },
                    "event": {
                      "type": "string"
                    },
                    "id": {
                      "type": "string"
                    },
                    "retry": {
                      "type": "integer",
                      "minimum": 0
                    }
                  },
                  "required": [
                    "data"
                  ]
                }
              }
            }
          },
          "404": {
            "description": "No run with this id"
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/workspaces": {
      "get": {
        "tags": [
          "workspaces"
        ],
        "summary": "Workspaces",
        "operationId": "listWorkspaces",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/WorkspaceOut"
                  },
                  "type": "array",
                  "title": "Response Listworkspaces"
                }
              }
            }
          }
        }
      }
    },
    "/workspaces/{workspace_id}/connections": {
      "get": {
        "tags": [
          "workspaces"
        ],
        "summary": "Connections",
        "description": "The workspace's connections, without their secrets.",
        "operationId": "listConnections",
        "parameters": [
          {
            "name": "workspace_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid",
              "title": "Workspace Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/ConnectionOut"
                  },
                  "title": "Response Listconnections"
                }
              }
            }
          },
          "404": {
            "description": "No workspace with this id"
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/workspaces/{workspace_id}/connections/claude": {
      "put": {
        "tags": [
          "workspaces"
        ],
        "summary": "Put Claude",
        "description": "Store the workspace's Claude API key, encrypted, replacing any stored one. The\nworkspace's runs on Claude use it.",
        "operationId": "putClaudeConnection",
        "parameters": [
          {
            "name": "workspace_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid",
              "title": "Workspace Id"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PutClaudeConnection"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ConnectionOut"
                }
              }
            }
          },
          "404": {
            "description": "No workspace with this id"
          },
          "503": {
            "description": "No master key is configured"
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      },
      "delete": {
        "tags": [
          "workspaces"
        ],
        "summary": "Delete Claude",
        "operationId": "deleteClaudeConnection",
        "parameters": [
          {
            "name": "workspace_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid",
              "title": "Workspace Id"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "Successful Response"
          },
          "404": {
            "description": "No such workspace, or it has no Claude connection"
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "AgentNode": {
        "properties": {
          "type": {
            "type": "string",
            "const": "agent",
            "title": "Type"
          },
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_-]{0,62}$",
            "title": "Id"
          },
          "role": {
            "type": "string",
            "minLength": 1,
            "title": "Role"
          },
          "instructions": {
            "type": "string",
            "minLength": 1,
            "title": "Instructions"
          },
          "provider": {
            "anyOf": [
              {
                "type": "string",
                "const": "claude"
              },
              {
                "type": "null"
              }
            ],
            "title": "Provider",
            "description": "Unset means the workspace default."
          },
          "model": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1
              },
              {
                "type": "null"
              }
            ],
            "title": "Model"
          },
          "tools": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Tools"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "type",
          "id",
          "role",
          "instructions"
        ],
        "title": "AgentNode",
        "description": "One agent turn: a role and instructions run on a provider."
      },
      "ConnectionOut": {
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "title": "Id"
          },
          "provider": {
            "type": "string",
            "const": "claude",
            "title": "Provider"
          },
          "key_hint": {
            "type": "string",
            "title": "Key Hint"
          },
          "created_at": {
            "type": "string",
            "format": "date-time",
            "title": "Created At"
          },
          "updated_at": {
            "type": "string",
            "format": "date-time",
            "title": "Updated At"
          }
        },
        "type": "object",
        "required": [
          "id",
          "provider",
          "key_hint",
          "created_at",
          "updated_at"
        ],
        "title": "ConnectionOut",
        "description": "A stored connection. Its secret is never returned; `key_hint` is its last 4 characters."
      },
      "CreateRunRequest": {
        "properties": {
          "workflow": {
            "$ref": "#/components/schemas/WorkflowSpec"
          },
          "input": {
            "type": "string",
            "title": "Input",
            "default": ""
          },
          "repo": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/RepoSource"
              },
              {
                "type": "null"
              }
            ],
            "description": "The repo the run works on, cloned into its sandbox. Needed by `repo.*` tools."
          },
          "workspace_id": {
            "anyOf": [
              {
                "type": "string",
                "format": "uuid"
              },
              {
                "type": "null"
              }
            ],
            "title": "Workspace Id",
            "description": "The workspace the run belongs to; its connections are used. Default: the default workspace."
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "workflow"
        ],
        "title": "CreateRunRequest"
      },
      "CreateRunResponse": {
        "properties": {
          "run_id": {
            "type": "string",
            "format": "uuid",
            "title": "Run Id"
          },
          "status": {
            "type": "string",
            "const": "queued",
            "title": "Status",
            "default": "queued"
          },
          "events_url": {
            "type": "string",
            "title": "Events Url"
          }
        },
        "type": "object",
        "required": [
          "run_id",
          "events_url"
        ],
        "title": "CreateRunResponse"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "Health": {
        "properties": {
          "status": {
            "type": "string",
            "const": "ok",
            "title": "Status",
            "default": "ok"
          }
        },
        "type": "object",
        "title": "Health"
      },
      "PutClaudeConnection": {
        "properties": {
          "api_key": {
            "type": "string",
            "maxLength": 512,
            "minLength": 8,
            "format": "password",
            "title": "Api Key",
            "description": "The Anthropic API key. Stored encrypted; it is never returned.",
            "writeOnly": true
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "api_key"
        ],
        "title": "PutClaudeConnection"
      },
      "Readiness": {
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "ok",
              "error"
            ],
            "title": "Status"
          },
          "postgres": {
            "type": "string",
            "enum": [
              "ok",
              "error"
            ],
            "title": "Postgres"
          },
          "redis": {
            "type": "string",
            "enum": [
              "ok",
              "error"
            ],
            "title": "Redis"
          }
        },
        "type": "object",
        "required": [
          "status",
          "postgres",
          "redis"
        ],
        "title": "Readiness"
      },
      "RepoSource": {
        "properties": {
          "url": {
            "type": "string",
            "maxLength": 2000,
            "minLength": 1,
            "title": "Url"
          },
          "ref": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 200,
                "pattern": "^[A-Za-z0-9._/][A-Za-z0-9._/-]*$"
              },
              {
                "type": "null"
              }
            ],
            "title": "Ref"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "url"
        ],
        "title": "RepoSource",
        "description": "The repo a run works on: an `https://` URL or a local path, at `ref` (default branch if\nunset)."
      },
      "SequenceNode": {
        "properties": {
          "type": {
            "type": "string",
            "const": "sequence",
            "title": "Type"
          },
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_-]{0,62}$",
            "title": "Id"
          },
          "steps": {
            "items": {
              "oneOf": [
                {
                  "$ref": "#/components/schemas/AgentNode"
                },
                {
                  "$ref": "#/components/schemas/SequenceNode"
                }
              ],
              "discriminator": {
                "propertyName": "type",
                "mapping": {
                  "agent": "#/components/schemas/AgentNode",
                  "sequence": "#/components/schemas/SequenceNode"
                }
              }
            },
            "type": "array",
            "minItems": 1,
            "title": "Steps"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "type",
          "id",
          "steps"
        ],
        "title": "SequenceNode",
        "description": "Runs its steps in order."
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      },
      "WorkflowSpec": {
        "properties": {
          "spec_version": {
            "type": "string",
            "const": "0",
            "title": "Spec Version"
          },
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_-]{0,62}$",
            "title": "Id"
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "title": "Name"
          },
          "description": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Description"
          },
          "root": {
            "oneOf": [
              {
                "$ref": "#/components/schemas/AgentNode"
              },
              {
                "$ref": "#/components/schemas/SequenceNode"
              }
            ],
            "title": "Root",
            "discriminator": {
              "propertyName": "type",
              "mapping": {
                "agent": "#/components/schemas/AgentNode",
                "sequence": "#/components/schemas/SequenceNode"
              }
            }
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "spec_version",
          "id",
          "name",
          "root"
        ],
        "title": "WorkflowSpec",
        "description": "A versioned workflow document with a single root node."
      },
      "WorkspaceOut": {
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "title": "Id"
          },
          "name": {
            "type": "string",
            "title": "Name"
          },
          "created_at": {
            "type": "string",
            "format": "date-time",
            "title": "Created At"
          }
        },
        "type": "object",
        "required": [
          "id",
          "name",
          "created_at"
        ],
        "title": "WorkspaceOut"
      },
      "JsonValue": {},
      "RunEvent": {
        "additionalProperties": false,
        "description": "One row of the run event log. For agent events, `type` is the `AgentEvent` type and\n`payload` is the serialised event; payloads are data, never instructions.",
        "properties": {
          "run_id": {
            "format": "uuid",
            "title": "Run Id",
            "type": "string"
          },
          "seq": {
            "minimum": 1,
            "title": "Seq",
            "type": "integer"
          },
          "type": {
            "minLength": 1,
            "title": "Type",
            "type": "string"
          },
          "node_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Node Id"
          },
          "payload": {
            "additionalProperties": {
              "$ref": "#/components/schemas/JsonValue"
            },
            "title": "Payload",
            "type": "object"
          },
          "created_at": {
            "format": "date-time",
            "title": "Created At",
            "type": "string"
          }
        },
        "required": [
          "run_id",
          "seq",
          "type",
          "created_at"
        ],
        "title": "RunEvent",
        "type": "object"
      }
    }
  }
}
