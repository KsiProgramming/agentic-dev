{
  "openapi": "3.1.0",
  "info": {
    "title": "Agentic Dev Platform API",
    "version": "0.1.0"
  },
  "paths": {
    "/health": {
      "get": {
        "tags": [
          "health"
        ],
        "summary": "Health",
        "description": "Liveness: the process is up. Checks no dependencies.",
        "operationId": "getHealth",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Health"
                }
              }
            }
          }
        }
      }
    },
    "/health/ready": {
      "get": {
        "tags": [
          "health"
        ],
        "summary": "Ready",
        "description": "Readiness: Postgres and Redis both answer.",
        "operationId": "getReadiness",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Readiness"
                }
              }
            }
          },
          "503": {
            "description": "A dependency is unavailable",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Readiness"
                }
              }
            }
          }
        }
      }
    },
    "/runs": {
      "post": {
        "tags": [
          "runs"
        ],
        "summary": "Create",
        "description": "Queue a run of `workflow` with `input` for its first node, working on `repo` if given.\nStream it from `events_url`. A workflow that publishes (`github.openPR`) must have a gate\nbetween the writer and the publishing node, or it is refused with `422`.",
        "operationId": "createRun",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateRunRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "202": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CreateRunResponse"
                }
              }
            }
          },
          "404": {
            "description": "No workspace with this id"
          },
          "409": {
            "description": "The workflow uses `github.*` tools, but the workspace has no GitHub connection"
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/runs/{run_id}/approvals": {
      "post": {
        "tags": [
          "runs"
        ],
        "summary": "Approve",
        "description": "Decide the gate the run is waiting at: `approve` continues the run, `reject` ends it\n`cancelled`. The run is queued again; its stream carries on with `gate_decided`.",
        "operationId": "approveRun",
        "parameters": [
          {
            "name": "run_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid",
              "title": "Run Id"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ApprovalRequest"
              }
            }
          }
        },
        "responses": {
          "202": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApprovalResponse"
                }
              }
            }
          },
          "404": {
            "description": "No run with this id"
          },
          "409": {
            "description": "The run is not waiting at this gate, or it was already decided"
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/runs/{run_id}/events": {
      "get": {
        "tags": [
          "runs"
        ],
        "summary": "Stream Run Events",
        "description": "The run's events as Server-Sent Events: stored ones first, then live ones as they are\nwritten. Each frame's `id` is the event's `seq`, `event` its type and `data` the `RunEvent`.\nThe stream ends after the run's final event.",
        "operationId": "streamRunEvents",
        "parameters": [
          {
            "name": "run_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid",
              "title": "Run Id"
            }
          },
          {
            "name": "after",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "integer",
                  "minimum": 0
                },
                {
                  "type": "null"
                }
              ],
              "description": "Start after this seq (`Last-Event-ID` wins).",
              "title": "After"
            },
            "description": "Start after this seq (`Last-Event-ID` wins)."
          },
          {
            "name": "last-event-id",
            "in": "header",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "integer",
                  "minimum": 0
                },
                {
                  "type": "null"
                }
              ],
              "title": "Last-Event-Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "text/event-stream": {
                "itemSchema": {
                  "type": "object",
                  "properties": {
                    "data": {
                      "type": "string",
                      "contentMediaType": "application/json",
                      "contentSchema": {
                        "$ref": "#/components/schemas/RunEvent"
                      }
                    },
                    "event": {
                      "type": "string"
                    },
                    "id": {
                      "type": "string"
                    },
                    "retry": {
                      "type": "integer",
                      "minimum": 0
                    }
                  },
                  "required": [
                    "data"
                  ]
                }
              }
            }
          },
          "404": {
            "description": "No run with this id"
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/workspaces": {
      "get": {
        "tags": [
          "workspaces"
        ],
        "summary": "Workspaces",
        "operationId": "listWorkspaces",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/WorkspaceOut"
                  },
                  "type": "array",
                  "title": "Response Listworkspaces"
                }
              }
            }
          }
        }
      }
    },
    "/workspaces/{workspace_id}/connections": {
      "get": {
        "tags": [
          "workspaces"
        ],
        "summary": "Connections",
        "description": "The workspace's connections, without their secrets.",
        "operationId": "listConnections",
        "parameters": [
          {
            "name": "workspace_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid",
              "title": "Workspace Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/ConnectionOut"
                  },
                  "title": "Response Listconnections"
                }
              }
            }
          },
          "404": {
            "description": "No workspace with this id"
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/workspaces/{workspace_id}/connections/claude": {
      "put": {
        "tags": [
          "workspaces"
        ],
        "summary": "Put Claude",
        "description": "Store the workspace's Claude API key, encrypted, replacing any stored one. The\nworkspace's runs on Claude use it.",
        "operationId": "putClaudeConnection",
        "parameters": [
          {
            "name": "workspace_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid",
              "title": "Workspace Id"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PutClaudeConnection"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ConnectionOut"
                }
              }
            }
          },
          "404": {
            "description": "No workspace with this id"
          },
          "503": {
            "description": "No master key is configured"
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      },
      "delete": {
        "tags": [
          "workspaces"
        ],
        "summary": "Delete Claude",
        "operationId": "deleteClaudeConnection",
        "parameters": [
          {
            "name": "workspace_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid",
              "title": "Workspace Id"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "Successful Response"
          },
          "404": {
            "description": "No such workspace, or it has no Claude connection"
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/workspaces/{workspace_id}/connections/github/install": {
      "post": {
        "tags": [
          "github"
        ],
        "summary": "Start Install",
        "description": "An install URL for the GitHub App. Installing it links the installation to the workspace.",
        "operationId": "startGithubInstall",
        "parameters": [
          {
            "name": "workspace_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid",
              "title": "Workspace Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/InstallUrlOut"
                }
              }
            }
          },
          "404": {
            "description": "No workspace with this id"
          },
          "503": {
            "description": "The GitHub App is not configured on the API"
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/github/setup": {
      "get": {
        "tags": [
          "github"
        ],
        "summary": "Complete Install",
        "description": "GitHub's redirect after an install (the App's Setup URL). Sends the browser back to the\nweb app's settings page with `github=connected`, or `github=error` and a `reason`.",
        "operationId": "completeGithubInstall",
        "parameters": [
          {
            "name": "installation_id",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "integer"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Installation Id"
            }
          },
          {
            "name": "setup_action",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Setup Action"
            }
          },
          {
            "name": "state",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "State"
            }
          }
        ],
        "responses": {
          "303": {
            "description": "Successful Response"
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/workspaces/{workspace_id}/repos": {
      "get": {
        "tags": [
          "github"
        ],
        "summary": "Repos",
        "description": "The repos the workspace's GitHub App installation can reach, by full name.",
        "operationId": "listRepos",
        "parameters": [
          {
            "name": "workspace_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid",
              "title": "Workspace Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/RepoOut"
                  },
                  "title": "Response Listrepos"
                }
              }
            }
          },
          "404": {
            "description": "No workspace with this id"
          },
          "409": {
            "description": "`no_connection`: the workspace has no GitHub connection. `installation_gone`: the App was uninstalled or lost access; install it again.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GithubErrorDetail"
                }
              }
            }
          },
          "502": {
            "description": "GitHub answered with an error or could not be reached"
          },
          "503": {
            "description": "The GitHub App is not configured on the API"
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/workspaces/{workspace_id}/connections/github": {
      "delete": {
        "tags": [
          "github"
        ],
        "summary": "Delete Github",
        "description": "Unlink the workspace from its installation. The App stays installed on GitHub.",
        "operationId": "deleteGithubConnection",
        "parameters": [
          {
            "name": "workspace_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid",
              "title": "Workspace Id"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "Successful Response"
          },
          "404": {
            "description": "No such workspace, or it has no GitHub connection"
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "AgentNode": {
        "properties": {
          "type": {
            "type": "string",
            "const": "agent",
            "title": "Type"
          },
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_-]{0,62}$",
            "title": "Id"
          },
          "role": {
            "type": "string",
            "minLength": 1,
            "title": "Role"
          },
          "instructions": {
            "type": "string",
            "minLength": 1,
            "title": "Instructions"
          },
          "provider": {
            "anyOf": [
              {
                "type": "string",
                "const": "claude"
              },
              {
                "type": "null"
              }
            ],
            "title": "Provider",
            "description": "Unset means the workspace default."
          },
          "model": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1
              },
              {
                "type": "null"
              }
            ],
            "title": "Model"
          },
          "tools": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Tools"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "type",
          "id",
          "role",
          "instructions"
        ],
        "title": "AgentNode",
        "description": "One agent turn: a role and instructions run on a provider."
      },
      "ApprovalRequest": {
        "properties": {
          "node_id": {
            "type": "string",
            "title": "Node Id",
            "description": "The gate the run is waiting at."
          },
          "decision": {
            "type": "string",
            "enum": [
              "approve",
              "reject"
            ],
            "title": "Decision"
          },
          "comment": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Comment"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "node_id",
          "decision"
        ],
        "title": "ApprovalRequest"
      },
      "ApprovalResponse": {
        "properties": {
          "run_id": {
            "type": "string",
            "format": "uuid",
            "title": "Run Id"
          },
          "node_id": {
            "type": "string",
            "title": "Node Id"
          },
          "decision": {
            "type": "string",
            "enum": [
              "approve",
              "reject"
            ],
            "title": "Decision"
          },
          "status": {
            "type": "string",
            "const": "queued",
            "title": "Status",
            "default": "queued"
          }
        },
        "type": "object",
        "required": [
          "run_id",
          "node_id",
          "decision"
        ],
        "title": "ApprovalResponse"
      },
      "ConnectionOut": {
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "title": "Id"
          },
          "provider": {
            "type": "string",
            "enum": [
              "claude",
              "github"
            ],
            "title": "Provider"
          },
          "key_hint": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Key Hint"
          },
          "account_login": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Account Login"
          },
          "created_at": {
            "type": "string",
            "format": "date-time",
            "title": "Created At"
          },
          "updated_at": {
            "type": "string",
            "format": "date-time",
            "title": "Updated At"
          }
        },
        "type": "object",
        "required": [
          "id",
          "provider",
          "created_at",
          "updated_at"
        ],
        "title": "ConnectionOut",
        "description": "A stored connection. Its secret is never returned; `key_hint` is its last 4 characters.\n\nA GitHub connection has no secret: it shows the account the App is installed on instead."
      },
      "CreateRunRequest": {
        "properties": {
          "workflow": {
            "$ref": "#/components/schemas/WorkflowSpec"
          },
          "input": {
            "type": "string",
            "title": "Input",
            "default": ""
          },
          "repo": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/RepoSource"
              },
              {
                "type": "null"
              }
            ],
            "description": "The repo the run works on, cloned into its sandbox. Needed by `repo.*` tools, and `github.*` tools need it to be on GitHub (`https://github.com/<owner>/<name>`)."
          },
          "workspace_id": {
            "anyOf": [
              {
                "type": "string",
                "format": "uuid"
              },
              {
                "type": "null"
              }
            ],
            "title": "Workspace Id",
            "description": "The workspace the run belongs to; its connections are used. Default: the default workspace."
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "workflow"
        ],
        "title": "CreateRunRequest"
      },
      "CreateRunResponse": {
        "properties": {
          "run_id": {
            "type": "string",
            "format": "uuid",
            "title": "Run Id"
          },
          "status": {
            "type": "string",
            "const": "queued",
            "title": "Status",
            "default": "queued"
          },
          "events_url": {
            "type": "string",
            "title": "Events Url"
          }
        },
        "type": "object",
        "required": [
          "run_id",
          "events_url"
        ],
        "title": "CreateRunResponse"
      },
      "GateNode": {
        "properties": {
          "type": {
            "type": "string",
            "const": "gate",
            "title": "Type"
          },
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_-]{0,62}$",
            "title": "Id"
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "title": "Title",
            "description": "What the approver is asked to decide."
          },
          "prompt": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Prompt",
            "description": "More guidance for the approver, shown with the input."
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "type",
          "id",
          "title"
        ],
        "title": "GateNode",
        "description": "A human decision point: the run pauses here until someone approves or rejects. Its input\n(the previous node's output) is shown to the approver and passes through unchanged."
      },
      "GithubErrorDetail": {
        "properties": {
          "code": {
            "type": "string",
            "title": "Code"
          },
          "message": {
            "type": "string",
            "title": "Message"
          }
        },
        "type": "object",
        "required": [
          "code",
          "message"
        ],
        "title": "GithubErrorDetail",
        "description": "The `detail` of a 409 from the repos endpoint: `code` says what the user should do."
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "Health": {
        "properties": {
          "status": {
            "type": "string",
            "const": "ok",
            "title": "Status",
            "default": "ok"
          }
        },
        "type": "object",
        "title": "Health"
      },
      "InstallUrlOut": {
        "properties": {
          "install_url": {
            "type": "string",
            "title": "Install Url"
          }
        },
        "type": "object",
        "required": [
          "install_url"
        ],
        "title": "InstallUrlOut",
        "description": "Where to send the browser to install the GitHub App. The URL is valid for 10 minutes."
      },
      "JsonValue": {},
