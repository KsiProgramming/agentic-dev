# Local development only. Copy to .env; never commit real secrets.
POSTGRES_USER=agentic
POSTGRES_PASSWORD=agentic
POSTGRES_DB=agentic

# Host ports for the services you open in a browser or with curl.
API_PORT=8000
WEB_PORT=3000
# Browser origins the API accepts (JSON list). Compose derives it from WEB_PORT.
# CORS_ORIGINS=["http://localhost:3000"]

# Agent runtime for the worker: "fake" (default, no network) or "claude".
# AGENTIC_RUNTIME=claude
# Runs on Claude use the key stored in their workspace (PUT /workspaces/{id}/connections/claude).
# A workspace with no stored key falls back to this one. Never commit a real key.
# ANTHROPIC_API_KEY=
# CLAUDE_MODEL=claude-sonnet-5-5

# Sandboxes for runs with a repo: "docker" (default in compose) or "fake" (host temp dirs, no
# isolation). The worker reaches Docker through its socket; on Linux set DOCKER_GID to the
# socket's group (`stat -c %g /var/run/docker.sock`). Docker Desktop needs nothing.
# SANDBOX_BACKEND=docker
# SANDBOX_IMAGE=alpine:3.20
# DOCKER_GID=0

# Stored secrets are encrypted with a master key. Compose makes one in the `secrets` volume; to
# run the API and worker outside compose, make one with
# `uv run python -m agentic_secrets generate-key .secrets/master.key` and point both at it.
# MASTER_KEY_FILE=.secrets/master.key

# Durable runs: a worker that stops renewing a run's lease for LEASE_TTL_S seconds is presumed
# dead, and another worker resumes its run. A run claimed more than MAX_ATTEMPTS times fails.
# LEASE_TTL_S=30
# MAX_ATTEMPTS=3
