{
  "$defs": {
    "AgentNode": {
      "additionalProperties": false,
      "description": "One agent turn: a role and instructions run on a provider.",
      "properties": {
        "id": {
          "pattern": "^[a-z][a-z0-9_-]{0,62}$",
          "title": "Id",
          "type": "string"
        },
        "instructions": {
          "minLength": 1,
          "title": "Instructions",
          "type": "string"
        },
        "model": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Model"
        },
        "provider": {
          "anyOf": [
            {
              "const": "claude",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Unset means the workspace default.",
          "title": "Provider"
        },
        "role": {
          "minLength": 1,
          "title": "Role",
          "type": "string"
        },
        "tools": {
          "items": {
            "type": "string"
          },
          "title": "Tools",
          "type": "array"
        },
        "type": {
          "const": "agent",
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "type",
        "id",
        "role",
        "instructions"
      ],
      "title": "AgentNode",
      "type": "object"
    },
    "GateNode": {
      "additionalProperties": false,
      "description": "A human decision point: the run pauses here until someone approves or rejects. Its input\n(the previous node's output) is shown to the approver and passes through unchanged.",
      "properties": {
        "id": {
          "pattern": "^[a-z][a-z0-9_-]{0,62}$",
          "title": "Id",
          "type": "string"
        },
        "prompt": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "More guidance for the approver, shown with the input.",
          "title": "Prompt"
        },
        "title": {
          "description": "What the approver is asked to decide.",
          "minLength": 1,
          "title": "Title",
          "type": "string"
        },
        "type": {
          "const": "gate",
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "type",
        "id",
        "title"
      ],
      "title": "GateNode",
      "type": "object"
    },
    "JsonValue": {},
    "LoopNode": {
      "additionalProperties": false,
      "description": "Runs its body again and again until `until` is true, at most `max_iterations` times.\n\nIteration 1 gets the loop's input; each later one gets the previous iteration's output, and\nthe loop's output is its last iteration's. `until` is a CEL condition over `last` (the body's\noutput), `iteration` (iterations completed, from 1) and `results` (node id → `{status, text,\ndata}`, the latest result of each node run so far). Reaching `max_iterations` ends the loop\nnormally. The body cannot contain gates, writers, publishers or loops: each is keyed by node\nid, which repeats in every iteration.",
      "properties": {
        "body": {
          "discriminator": {
            "mapping": {
              "agent": "#/$defs/AgentNode",
              "gate": "#/$defs/GateNode",
              "loop": "#/$defs/LoopNode",
              "map": "#/$defs/MapNode",
              "reduce": "#/$defs/ReduceNode",
              "sequence": "#/$defs/SequenceNode",
              "tool": "#/$defs/ToolNode"
            },
            "propertyName": "type"
          },
          "oneOf": [
            {
              "$ref": "#/$defs/AgentNode"
            },
            {
              "$ref": "#/$defs/ToolNode"
            },
            {
              "$ref": "#/$defs/GateNode"
            },
            {
              "$ref": "#/$defs/SequenceNode"
            },
            {
              "$ref": "#/$defs/LoopNode"
            },
            {
              "$ref": "#/$defs/MapNode"
            },
            {
              "$ref": "#/$defs/ReduceNode"
            }
          ],
          "title": "Body"
        },
        "id": {
          "pattern": "^[a-z][a-z0-9_-]{0,62}$",
          "title": "Id",
          "type": "string"
        },
        "max_iterations": {
          "maximum": 5,
          "minimum": 1,
          "title": "Max Iterations",
          "type": "integer"
        },
        "type": {
          "const": "loop",
          "title": "Type",
          "type": "string"
        },
        "until": {
          "description": "CEL condition checked after each iteration; true stops the loop.",
          "examples": [
            "last.contains(\"APPROVED\")"
          ],
          "minLength": 1,
          "title": "Until",
          "type": "string"
        }
      },
      "required": [
        "type",
        "id",
        "body",
        "until",
        "max_iterations"
      ],
      "title": "LoopNode",
      "type": "object"
    },
    "MapNode": {
      "additionalProperties": false,
      "description": "Runs its body once per item of the list `over` evaluates to, at most `max_concurrency` at\na time, and outputs the items' outputs in item order.\n\n`over` is a CEL expression over `last` (the map's input) and `results` (as for a loop's\n`until`), e.g. `results.list_modules.data.modules`. Each item is its body's input: a string\nas is, any other value as JSON. The body can only hold agent, tool and sequence nodes: the\nothers are keyed by node id, which repeats for every item. A map has at most\n`MAX_AGENTS_SPAWNED` items; one that does not complete fails the map.",
      "properties": {
        "body": {
          "discriminator": {
            "mapping": {
              "agent": "#/$defs/AgentNode",
              "gate": "#/$defs/GateNode",
              "loop": "#/$defs/LoopNode",
              "map": "#/$defs/MapNode",
              "reduce": "#/$defs/ReduceNode",
              "sequence": "#/$defs/SequenceNode",
              "tool": "#/$defs/ToolNode"
            },
            "propertyName": "type"
          },
          "oneOf": [
            {
              "$ref": "#/$defs/AgentNode"
            },
            {
              "$ref": "#/$defs/ToolNode"
            },
            {
              "$ref": "#/$defs/GateNode"
            },
            {
              "$ref": "#/$defs/SequenceNode"
            },
            {
              "$ref": "#/$defs/LoopNode"
            },
            {
              "$ref": "#/$defs/MapNode"
            },
            {
              "$ref": "#/$defs/ReduceNode"
            }
          ],
          "title": "Body"
        },
        "id": {
          "pattern": "^[a-z][a-z0-9_-]{0,62}$",
          "title": "Id",
          "type": "string"
        },
        "max_concurrency": {
          "maximum": 8,
          "minimum": 1,
          "title": "Max Concurrency",
          "type": "integer"
        },
        "over": {
          "description": "CEL expression that evaluates to the list of items.",
          "examples": [
            "results.list_modules.data.modules"
          ],
          "minLength": 1,
          "title": "Over",
          "type": "string"
        },
        "type": {
          "const": "map",
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "type",
        "id",
        "over",
        "body",
        "max_concurrency"
      ],
      "title": "MapNode",
      "type": "object"
    },
    "ReduceAgent": {
      "additionalProperties": false,
      "description": "The agent a `reduce` node with the `agent` strategy runs, as for an `agent` node.",
      "properties": {
        "instructions": {
          "minLength": 1,
          "title": "Instructions",
          "type": "string"
        },
        "model": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Model"
        },
        "provider": {
          "anyOf": [
            {
              "const": "claude",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Unset means the workspace default.",
          "title": "Provider"
        },
        "role": {
          "minLength": 1,
          "title": "Role",
          "type": "string"
        }
      },
      "required": [
        "role",
        "instructions"
      ],
      "title": "ReduceAgent",
      "type": "object"
    },
    "ReduceNode": {
      "additionalProperties": false,
      "description": "Combines the outputs of the map `from`, which runs before it, in item order.\n\n`concat` joins them with `separator`. `agent` runs one agent turn whose input is the JSON\narray `[{\"item\": …, \"output\": …}]` (data, never instructions).",
      "properties": {
        "agent": {
          "anyOf": [
            {
              "$ref": "#/$defs/ReduceAgent"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "`agent` only, and required."
        },
        "from": {
          "description": "The map whose outputs are combined.",
          "pattern": "^[a-z][a-z0-9_-]{0,62}$",
          "title": "From",
          "type": "string"
        },
        "id": {
          "pattern": "^[a-z][a-z0-9_-]{0,62}$",
          "title": "Id",
          "type": "string"
        },
        "separator": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "`concat` only: what goes between outputs (default two newlines).",
          "title": "Separator"
        },
        "strategy": {
          "enum": [
            "concat",
            "agent"
          ],
          "title": "Strategy",
          "type": "string"
        },
        "type": {
          "const": "reduce",
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "type",
        "id",
        "from",
        "strategy"
      ],
      "title": "ReduceNode",
      "type": "object"
    },
    "SequenceNode": {
      "additionalProperties": false,
      "description": "Runs its steps in order.",
      "properties": {
        "id": {
          "pattern": "^[a-z][a-z0-9_-]{0,62}$",
          "title": "Id",
          "type": "string"
        },
        "steps": {
          "items": {
            "discriminator": {
              "mapping": {
                "agent": "#/$defs/AgentNode",
                "gate": "#/$defs/GateNode",
                "loop": "#/$defs/LoopNode",
                "map": "#/$defs/MapNode",
                "reduce": "#/$defs/ReduceNode",
                "sequence": "#/$defs/SequenceNode",
                "tool": "#/$defs/ToolNode"
              },
              "propertyName": "type"
            },
            "oneOf": [
              {
                "$ref": "#/$defs/AgentNode"
              },
              {
                "$ref": "#/$defs/ToolNode"
              },
              {
                "$ref": "#/$defs/GateNode"
              },
              {
                "$ref": "#/$defs/SequenceNode"
              },
              {
                "$ref": "#/$defs/LoopNode"
              },
              {
                "$ref": "#/$defs/MapNode"
              },
              {
                "$ref": "#/$defs/ReduceNode"
              }
            ]
          },
          "minItems": 1,
          "title": "Steps",
          "type": "array"
        },
        "type": {
          "const": "sequence",
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "type",
        "id",
        "steps"
      ],
      "title": "SequenceNode",
      "type": "object"
    },
    "ToolNode": {
      "additionalProperties": false,
      "description": "One call of a platform tool with fixed arguments; no model is involved. Its output is the\nnext node's input, and an error result fails the node.",
      "properties": {
        "args": {
          "additionalProperties": {
            "$ref": "#/$defs/JsonValue"
          },
          "description": "The tool's arguments.",
          "title": "Args",
          "type": "object"
        },
        "id": {
          "pattern": "^[a-z][a-z0-9_-]{0,62}$",
          "title": "Id",
          "type": "string"
        },
        "tool": {
          "description": "The platform tool to call, e.g. `repo.list_files`.",
          "minLength": 1,
          "title": "Tool",
          "type": "string"
        },
        "type": {
          "const": "tool",
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "type",
        "id",
        "tool"
      ],
      "title": "ToolNode",
      "type": "object"
    }
  },
  "$id": "https://github.com/KsiProgramming/agentic-dev/schemas/workflow-spec.v0.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "A versioned workflow document with a single root node.",
  "properties": {
    "description": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Description"
    },
    "id": {
      "pattern": "^[a-z][a-z0-9_-]{0,62}$",
      "title": "Id",
      "type": "string"
    },
    "name": {
      "minLength": 1,
      "title": "Name",
      "type": "string"
    },
    "root": {
      "discriminator": {
        "mapping": {
          "agent": "#/$defs/AgentNode",
          "gate": "#/$defs/GateNode",
          "loop": "#/$defs/LoopNode",
          "map": "#/$defs/MapNode",
          "reduce": "#/$defs/ReduceNode",
          "sequence": "#/$defs/SequenceNode",
          "tool": "#/$defs/ToolNode"
        },
        "propertyName": "type"
      },
      "oneOf": [
        {
          "$ref": "#/$defs/AgentNode"
        },
        {
          "$ref": "#/$defs/ToolNode"
        },
        {
          "$ref": "#/$defs/GateNode"
        },
        {
          "$ref": "#/$defs/SequenceNode"
        },
        {
          "$ref": "#/$defs/LoopNode"
        },
        {
          "$ref": "#/$defs/MapNode"
        },
        {
          "$ref": "#/$defs/ReduceNode"
        }
      ],
      "title": "Root"
    },
    "spec_version": {
      "const": "0",
      "title": "Spec Version",
      "type": "string"
    }
  },
  "required": [
    "spec_version",
    "id",
    "name",
    "root"
  ],
  "title": "Workflow spec v0",
  "type": "object"
}
