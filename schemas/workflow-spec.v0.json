{
  "$defs": {
    "AgentNode": {
      "additionalProperties": false,
      "description": "One agent turn: a role and instructions run on a provider.",
      "properties": {
        "id": {
          "pattern": "^[a-z][a-z0-9_-]{0,62}$",
          "title": "Id",
          "type": "string"
        },
        "input_schema": {
          "anyOf": [
            {
              "additionalProperties": {
                "$ref": "#/$defs/JsonValue"
              },
              "description": "A JSON Schema 2020-12 whose root is an object, with only local `$ref`s.",
              "examples": [
                {
                  "properties": {
                    "findings": {}
                  },
                  "required": [
                    "findings"
                  ],
                  "type": "object"
                }
              ],
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Its input must be JSON that matches this, or it does not start.",
          "title": "Input Schema"
        },
        "instructions": {
          "minLength": 1,
          "title": "Instructions",
          "type": "string"
        },
        "model": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Model"
        },
        "output_schema": {
          "anyOf": [
            {
              "additionalProperties": {
                "$ref": "#/$defs/JsonValue"
              },
              "description": "A JSON Schema 2020-12 whose root is an object, with only local `$ref`s.",
              "examples": [
                {
                  "properties": {
                    "findings": {}
                  },
                  "required": [
                    "findings"
                  ],
                  "type": "object"
                }
              ],
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "It is asked to answer with JSON that matches this, and fails if it does not; the parsed object is its `data`.",
          "title": "Output Schema"
        },
        "provider": {
          "anyOf": [
            {
              "const": "claude",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Unset means the workspace default.",
          "title": "Provider"
        },
        "reads": {
          "description": "Take these run artifacts as input, instead of the previous output: one artifact's content, or an object by name for several.",
          "items": {
            "description": "A run artifact's name: letters, digits, `.`, `_` and `-`, ending in `.json`, `.md` or `.txt`, which give its media type.",
            "examples": [
              "findings.json"
            ],
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,58}\\.(json|md|txt)$",
            "type": "string"
          },
          "maxItems": 8,
          "title": "Reads",
          "type": "array"
        },
        "role": {
          "minLength": 1,
          "title": "Role",
          "type": "string"
        },
        "tools": {
          "items": {
            "type": "string"
          },
          "title": "Tools",
          "type": "array"
        },
        "type": {
          "const": "agent",
          "title": "Type",
          "type": "string"
        },
        "writes": {
          "anyOf": [
            {
              "description": "A run artifact's name: letters, digits, `.`, `_` and `-`, ending in `.json`, `.md` or `.txt`, which give its media type.",
              "examples": [
                "findings.json"
              ],
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,58}\\.(json|md|txt)$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Write the node's output as this run artifact (a new version each time it runs); a `.json` artifact must be JSON.",
          "title": "Writes"
        }
      },
      "required": [
        "type",
        "id",
        "role",
        "instructions"
      ],
      "title": "AgentNode",
      "type": "object"
    },
    "GateNode": {
      "additionalProperties": false,
      "description": "A human decision point: the run pauses here until someone approves or rejects. Its input\n(the previous node's output) is shown to the approver and passes through unchanged.",
      "properties": {
        "id": {
          "pattern": "^[a-z][a-z0-9_-]{0,62}$",
          "title": "Id",
          "type": "string"
        },
        "prompt": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "More guidance for the approver, shown with the input.",
          "title": "Prompt"
        },
        "title": {
          "description": "What the approver is asked to decide.",
          "minLength": 1,
          "title": "Title",
          "type": "string"
        },
        "ttl_s": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Seconds the gate waits for a decision before the run is cancelled; at most the run's `approval_ttl_s`, which applies when this is unset.",
          "title": "Ttl S"
        },
        "type": {
          "const": "gate",
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "type",
        "id",
        "title"
      ],
      "title": "GateNode",
      "type": "object"
    },
    "JsonValue": {},
    "LoopNode": {
      "additionalProperties": false,
      "description": "Runs its body again and again until `until` is true, at most `max_iterations` times.\n\nIteration 1 gets the loop's input; each later one gets the previous iteration's output, and\nthe loop's output is its last iteration's. `until` is a CEL condition over `last` (the body's\noutput), `iteration` (iterations completed, from 1) and `results` (node id → `{status, text,\ndata}`, the latest result of each node run so far). Reaching `max_iterations` ends the loop\nnormally. The body cannot contain gates, writers, publishers or loops: each is keyed by node\nid, which repeats in every iteration.",
      "properties": {
        "body": {
          "discriminator": {
            "mapping": {
              "agent": "#/$defs/AgentNode",
              "gate": "#/$defs/GateNode",
              "loop": "#/$defs/LoopNode",
              "map": "#/$defs/MapNode",
              "parallel": "#/$defs/ParallelNode",
              "reduce": "#/$defs/ReduceNode",
              "router": "#/$defs/RouterNode",
              "sequence": "#/$defs/SequenceNode",
              "tool": "#/$defs/ToolNode"
            },
            "propertyName": "type"
          },
          "oneOf": [
            {
              "$ref": "#/$defs/AgentNode"
            },
            {
              "$ref": "#/$defs/ToolNode"
            },
            {
              "$ref": "#/$defs/GateNode"
            },
            {
              "$ref": "#/$defs/SequenceNode"
            },
            {
              "$ref": "#/$defs/LoopNode"
            },
            {
              "$ref": "#/$defs/MapNode"
            },
            {
              "$ref": "#/$defs/ReduceNode"
            },
            {
              "$ref": "#/$defs/ParallelNode"
            },
            {
              "$ref": "#/$defs/RouterNode"
            }
          ],
          "title": "Body"
        },
        "id": {
          "pattern": "^[a-z][a-z0-9_-]{0,62}$",
          "title": "Id",
          "type": "string"
        },
        "max_iterations": {
          "maximum": 5,
          "minimum": 1,
          "title": "Max Iterations",
          "type": "integer"
        },
        "type": {
          "const": "loop",
          "title": "Type",
          "type": "string"
        },
        "until": {
          "description": "CEL condition checked after each iteration; true stops the loop.",
          "examples": [
            "last.contains(\"APPROVED\")"
          ],
          "minLength": 1,
          "title": "Until",
          "type": "string"
        }
      },
      "required": [
        "type",
        "id",
        "body",
        "until",
        "max_iterations"
      ],
      "title": "LoopNode",
      "type": "object"
    },
    "MapNode": {
      "additionalProperties": false,
      "description": "Runs its body once per item of the list `over` evaluates to, at most `max_concurrency` at\na time, and outputs the items' outputs in item order.\n\n`over` is a CEL expression over `last` (the map's input) and `results` (as for a loop's\n`until`), e.g. `results.list_modules.data.modules`. Each item is its body's input: a string\nas is, any other value as JSON. The body can only hold agent, tool and sequence nodes: the\nothers are keyed by node id, which repeats for every item. Its items' agents count toward the\nrun's `agents_spawned` limit; one item that does not complete fails the map.",
      "properties": {
        "body": {
          "discriminator": {
            "mapping": {
              "agent": "#/$defs/AgentNode",
              "gate": "#/$defs/GateNode",
              "loop": "#/$defs/LoopNode",
              "map": "#/$defs/MapNode",
              "parallel": "#/$defs/ParallelNode",
              "reduce": "#/$defs/ReduceNode",
              "router": "#/$defs/RouterNode",
              "sequence": "#/$defs/SequenceNode",
              "tool": "#/$defs/ToolNode"
            },
            "propertyName": "type"
          },
          "oneOf": [
            {
              "$ref": "#/$defs/AgentNode"
            },
            {
              "$ref": "#/$defs/ToolNode"
            },
            {
              "$ref": "#/$defs/GateNode"
            },
            {
              "$ref": "#/$defs/SequenceNode"
            },
            {
              "$ref": "#/$defs/LoopNode"
            },
            {
              "$ref": "#/$defs/MapNode"
            },
            {
              "$ref": "#/$defs/ReduceNode"
            },
            {
              "$ref": "#/$defs/ParallelNode"
            },
            {
              "$ref": "#/$defs/RouterNode"
            }
          ],
          "title": "Body"
        },
        "id": {
          "pattern": "^[a-z][a-z0-9_-]{0,62}$",
          "title": "Id",
          "type": "string"
        },
        "max_concurrency": {
          "maximum": 8,
          "minimum": 1,
          "title": "Max Concurrency",
          "type": "integer"
        },
        "over": {
          "description": "CEL expression that evaluates to the list of items.",
          "examples": [
            "results.list_modules.data.modules"
          ],
          "minLength": 1,
          "title": "Over",
          "type": "string"
        },
        "type": {
          "const": "map",
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "type",
        "id",
        "over",
        "body",
        "max_concurrency"
      ],
      "title": "MapNode",
      "type": "object"
    },
    "ParallelNode": {
      "additionalProperties": false,
      "description": "Runs its branches at the same time, each on the parallel's input, and joins them.\n\n`join` says when the parallel is done: `all` once every branch completed, `any` once one\ndid, `quorum` once `quorum` did. It decides as soon as the outcome is known (`all` fails on\nthe first branch that does not complete, the others once the join can no longer be met) and\nthe branches still running end `node_cancelled`. Its output is the completed branches'\noutputs in branch order. A branch is one `agent`, `tool` or `sequence` node, its id names the\nbranch, and it holds no gate, writer or publisher. Every agent in the branches counts toward\nthe run's `agents_spawned` limit when the parallel starts.",
      "properties": {
        "branches": {
          "items": {
            "discriminator": {
              "mapping": {
                "agent": "#/$defs/AgentNode",
                "gate": "#/$defs/GateNode",
                "loop": "#/$defs/LoopNode",
                "map": "#/$defs/MapNode",
                "parallel": "#/$defs/ParallelNode",
                "reduce": "#/$defs/ReduceNode",
                "router": "#/$defs/RouterNode",
                "sequence": "#/$defs/SequenceNode",
                "tool": "#/$defs/ToolNode"
              },
              "propertyName": "type"
            },
            "oneOf": [
              {
                "$ref": "#/$defs/AgentNode"
              },
              {
                "$ref": "#/$defs/ToolNode"
              },
              {
                "$ref": "#/$defs/GateNode"
              },
              {
                "$ref": "#/$defs/SequenceNode"
              },
              {
                "$ref": "#/$defs/LoopNode"
              },
              {
                "$ref": "#/$defs/MapNode"
              },
              {
                "$ref": "#/$defs/ReduceNode"
              },
              {
                "$ref": "#/$defs/ParallelNode"
              },
              {
                "$ref": "#/$defs/RouterNode"
              }
            ]
          },
          "maxItems": 8,
          "minItems": 2,
          "title": "Branches",
          "type": "array"
        },
        "id": {
          "pattern": "^[a-z][a-z0-9_-]{0,62}$",
          "title": "Id",
          "type": "string"
        },
        "join": {
          "enum": [
            "all",
            "any",
            "quorum"
          ],
          "title": "Join",
          "type": "string"
        },
        "quorum": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "`quorum` only, and required: how many branches must complete.",
          "title": "Quorum"
        },
        "type": {
          "const": "parallel",
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "type",
        "id",
        "branches",
        "join"
      ],
      "title": "ParallelNode",
      "type": "object"
    },
    "ReduceAgent": {
      "additionalProperties": false,
      "description": "The agent a `reduce` node with the `agent` strategy runs, as for an `agent` node.",
      "properties": {
        "instructions": {
          "minLength": 1,
          "title": "Instructions",
          "type": "string"
        },
        "model": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Model"
        },
        "provider": {
          "anyOf": [
            {
              "const": "claude",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Unset means the workspace default.",
          "title": "Provider"
        },
        "role": {
          "minLength": 1,
          "title": "Role",
          "type": "string"
        }
      },
      "required": [
        "role",
        "instructions"
      ],
      "title": "ReduceAgent",
      "type": "object"
    },
    "ReduceNode": {
      "additionalProperties": false,
      "description": "Combines the outputs of the map or parallel `from`, which runs before it: a map's items in\nitem order, a parallel's completed branches in branch order.\n\n`concat` joins them with `separator`. `agent` runs one agent turn whose input is the JSON\narray `[{\"item\": …, \"output\": …}]` (data, never instructions; a branch's item is its id).\n`dedupe` and `vote` (4.5) merge findings reports with no model: one finding per issue, with\nthe highest severity, the sources that reported it and a confidence; `vote` keeps only the\nissues `min_votes` sources reported. Their output is a findings report.",
      "properties": {
        "agent": {
          "anyOf": [
            {
              "$ref": "#/$defs/ReduceAgent"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "`agent` only, and required."
        },
        "from": {
          "description": "The map or parallel whose outputs are combined.",
          "pattern": "^[a-z][a-z0-9_-]{0,62}$",
          "title": "From",
          "type": "string"
        },
        "id": {
          "pattern": "^[a-z][a-z0-9_-]{0,62}$",
          "title": "Id",
          "type": "string"
        },
        "min_votes": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "`vote` only: how many sources must report an issue to keep it (default a majority of the sources that completed).",
          "title": "Min Votes"
        },
        "separator": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "`concat` only: what goes between outputs (default two newlines).",
          "title": "Separator"
        },
        "strategy": {
          "enum": [
            "concat",
            "agent",
            "dedupe",
            "vote"
          ],
          "title": "Strategy",
          "type": "string"
        },
        "type": {
          "const": "reduce",
          "title": "Type",
          "type": "string"
        },
        "writes": {
          "anyOf": [
            {
              "description": "A run artifact's name: letters, digits, `.`, `_` and `-`, ending in `.json`, `.md` or `.txt`, which give its media type.",
              "examples": [
                "findings.json"
              ],
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,58}\\.(json|md|txt)$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Write the node's output as this run artifact (a new version each time it runs); a `.json` artifact must be JSON.",
          "title": "Writes"
        }
      },
      "required": [
        "type",
        "id",
        "from",
        "strategy"
      ],
      "title": "ReduceNode",
      "type": "object"
    },
    "Route": {
      "additionalProperties": false,
      "description": "One way a router can go: `then` runs when this route is chosen.",
      "properties": {
        "description": {
          "anyOf": [
            {
              "maxLength": 300,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "What the route is for; a classifier is shown it to choose.",
          "title": "Description"
        },
        "id": {
          "description": "The route's name, shown in the console and the events.",
          "pattern": "^[a-z][a-z0-9_-]{0,62}$",
          "title": "Id",
          "type": "string"
        },
        "then": {
          "description": "What runs on this route: one agent, tool or sequence node.",
          "discriminator": {
            "mapping": {
              "agent": "#/$defs/AgentNode",
              "gate": "#/$defs/GateNode",
              "loop": "#/$defs/LoopNode",
              "map": "#/$defs/MapNode",
              "parallel": "#/$defs/ParallelNode",
              "reduce": "#/$defs/ReduceNode",
              "router": "#/$defs/RouterNode",
              "sequence": "#/$defs/SequenceNode",
              "tool": "#/$defs/ToolNode"
            },
            "propertyName": "type"
          },
          "oneOf": [
            {
              "$ref": "#/$defs/AgentNode"
            },
            {
              "$ref": "#/$defs/ToolNode"
            },
            {
              "$ref": "#/$defs/GateNode"
            },
            {
              "$ref": "#/$defs/SequenceNode"
            },
            {
              "$ref": "#/$defs/LoopNode"
            },
            {
              "$ref": "#/$defs/MapNode"
            },
            {
              "$ref": "#/$defs/ReduceNode"
            },
            {
              "$ref": "#/$defs/ParallelNode"
            },
            {
              "$ref": "#/$defs/RouterNode"
            }
          ],
          "title": "Then"
        },
        "when": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Rule mode, and required there: the CEL condition that picks this route.",
          "examples": [
            "artifacts[\"findings.json\"].findings.size() == 0"
          ],
          "title": "When"
        }
      },
      "required": [
        "id",
        "then"
      ],
      "title": "Route",
      "type": "object"
    },
    "RouterClassifier": {
      "additionalProperties": false,
      "description": "The agent that chooses a router's route (classifier mode), as for an `agent` node. It\nanswers with one of the router's route ids and a reason, through a typed output the engine\nmakes (`classifier_schema`).",
      "properties": {
        "instructions": {
          "minLength": 1,
          "title": "Instructions",
          "type": "string"
        },
        "model": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Model"
        },
        "provider": {
          "anyOf": [
            {
              "const": "claude",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Unset means the workspace default.",
          "title": "Provider"
        }
      },
      "required": [
        "instructions"
      ],
      "title": "RouterClassifier",
      "type": "object"
    },
    "RouterNode": {
      "additionalProperties": false,
      "description": "Runs exactly one of its routes, on the router's input, and outputs what that route outputs.\n\nIn rule mode every route has `when`, a CEL condition over `last` (the router's input),\n`results` and `artifacts` (as for a loop's `until`); the first route whose condition is true\nruns, else `default`. In classifier mode no route has `when`: one agent (`classifier`)\nchooses a route id, `default` included when there is one, and says why. A router with no\nmatching route and no `default` fails. The routes not taken never start. A route is one\n`agent`, `tool` or `sequence` node, and it may hold what the router's own place allows.",
      "properties": {
        "classifier": {
          "anyOf": [
            {
              "$ref": "#/$defs/RouterClassifier"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Classifier mode: the agent that chooses the route."
        },
        "default": {
          "anyOf": [
            {
              "discriminator": {
                "mapping": {
                  "agent": "#/$defs/AgentNode",
                  "gate": "#/$defs/GateNode",
                  "loop": "#/$defs/LoopNode",
                  "map": "#/$defs/MapNode",
                  "parallel": "#/$defs/ParallelNode",
                  "reduce": "#/$defs/ReduceNode",
                  "router": "#/$defs/RouterNode",
                  "sequence": "#/$defs/SequenceNode",
                  "tool": "#/$defs/ToolNode"
                },
                "propertyName": "type"
              },
              "oneOf": [
                {
                  "$ref": "#/$defs/AgentNode"
                },
                {
                  "$ref": "#/$defs/ToolNode"
                },
                {
                  "$ref": "#/$defs/GateNode"
                },
                {
                  "$ref": "#/$defs/SequenceNode"
                },
                {
                  "$ref": "#/$defs/LoopNode"
                },
                {
                  "$ref": "#/$defs/MapNode"
                },
                {
                  "$ref": "#/$defs/ReduceNode"
                },
                {
                  "$ref": "#/$defs/ParallelNode"
                },
                {
                  "$ref": "#/$defs/RouterNode"
                }
              ]
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "What runs when no route is chosen.",
          "title": "Default"
        },
        "id": {
          "pattern": "^[a-z][a-z0-9_-]{0,62}$",
          "title": "Id",
          "type": "string"
        },
        "routes": {
          "items": {
            "$ref": "#/$defs/Route"
          },
          "maxItems": 8,
          "minItems": 1,
          "title": "Routes",
          "type": "array"
        },
        "type": {
          "const": "router",
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "type",
        "id",
        "routes"
      ],
      "title": "RouterNode",
      "type": "object"
    },
    "SequenceNode": {
      "additionalProperties": false,
      "description": "Runs its steps in order.",
      "properties": {
        "id": {
          "pattern": "^[a-z][a-z0-9_-]{0,62}$",
          "title": "Id",
          "type": "string"
        },
        "steps": {
          "items": {
            "discriminator": {
              "mapping": {
                "agent": "#/$defs/AgentNode",
                "gate": "#/$defs/GateNode",
                "loop": "#/$defs/LoopNode",
                "map": "#/$defs/MapNode",
                "parallel": "#/$defs/ParallelNode",
                "reduce": "#/$defs/ReduceNode",
                "router": "#/$defs/RouterNode",
                "sequence": "#/$defs/SequenceNode",
                "tool": "#/$defs/ToolNode"
              },
              "propertyName": "type"
            },
            "oneOf": [
              {
                "$ref": "#/$defs/AgentNode"
              },
              {
                "$ref": "#/$defs/ToolNode"
              },
              {
                "$ref": "#/$defs/GateNode"
              },
              {
                "$ref": "#/$defs/SequenceNode"
              },
              {
                "$ref": "#/$defs/LoopNode"
              },
              {
                "$ref": "#/$defs/MapNode"
              },
              {
                "$ref": "#/$defs/ReduceNode"
              },
              {
                "$ref": "#/$defs/ParallelNode"
              },
              {
                "$ref": "#/$defs/RouterNode"
              }
            ]
          },
          "minItems": 1,
          "title": "Steps",
          "type": "array"
        },
        "type": {
          "const": "sequence",
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "type",
        "id",
        "steps"
      ],
      "title": "SequenceNode",
      "type": "object"
    },
    "ToolNode": {
      "additionalProperties": false,
      "description": "One call of a platform tool with fixed arguments; no model is involved. Its output is the\nnext node's input, and an error result fails the node.",
      "properties": {
        "args": {
          "additionalProperties": {
            "$ref": "#/$defs/JsonValue"
          },
          "description": "The tool's arguments.",
          "title": "Args",
          "type": "object"
        },
        "id": {
          "pattern": "^[a-z][a-z0-9_-]{0,62}$",
          "title": "Id",
          "type": "string"
        },
        "input_schema": {
          "anyOf": [
            {
              "additionalProperties": {
                "$ref": "#/$defs/JsonValue"
              },
              "description": "A JSON Schema 2020-12 whose root is an object, with only local `$ref`s.",
              "examples": [
                {
                  "properties": {
                    "findings": {}
                  },
                  "required": [
                    "findings"
                  ],
                  "type": "object"
                }
              ],
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Its input must be JSON that matches this, or it does not run.",
          "title": "Input Schema"
        },
        "output_schema": {
          "anyOf": [
            {
              "additionalProperties": {
                "$ref": "#/$defs/JsonValue"
              },
              "description": "A JSON Schema 2020-12 whose root is an object, with only local `$ref`s.",
              "examples": [
                {
                  "properties": {
                    "findings": {}
                  },
                  "required": [
                    "findings"
                  ],
                  "type": "object"
                }
              ],
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Its structured result (else its text as JSON) must match this, or it fails.",
          "title": "Output Schema"
        },
        "reads": {
          "description": "Take these run artifacts as input, instead of the previous output: one artifact's content, or an object by name for several.",
          "items": {
            "description": "A run artifact's name: letters, digits, `.`, `_` and `-`, ending in `.json`, `.md` or `.txt`, which give its media type.",
            "examples": [
              "findings.json"
            ],
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,58}\\.(json|md|txt)$",
            "type": "string"
          },
          "maxItems": 8,
          "title": "Reads",
          "type": "array"
        },
        "tool": {
          "description": "The platform tool to call, e.g. `repo.list_files`.",
          "minLength": 1,
          "title": "Tool",
          "type": "string"
        },
        "type": {
          "const": "tool",
          "title": "Type",
          "type": "string"
        },
        "writes": {
          "anyOf": [
            {
              "description": "A run artifact's name: letters, digits, `.`, `_` and `-`, ending in `.json`, `.md` or `.txt`, which give its media type.",
              "examples": [
                "findings.json"
              ],
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,58}\\.(json|md|txt)$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Write the node's output as this run artifact (a new version each time it runs); a `.json` artifact must be JSON.",
          "title": "Writes"
        }
      },
      "required": [
        "type",
        "id",
        "tool"
      ],
      "title": "ToolNode",
      "type": "object"
    }
  },
  "$id": "https://github.com/KsiProgramming/agentic-dev/schemas/workflow-spec.v0.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "A versioned workflow document with a single root node.",
  "properties": {
    "description": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Description"
    },
    "id": {
      "pattern": "^[a-z][a-z0-9_-]{0,62}$",
      "title": "Id",
      "type": "string"
    },
    "name": {
      "minLength": 1,
      "title": "Name",
      "type": "string"
    },
    "root": {
      "discriminator": {
        "mapping": {
          "agent": "#/$defs/AgentNode",
          "gate": "#/$defs/GateNode",
          "loop": "#/$defs/LoopNode",
          "map": "#/$defs/MapNode",
          "parallel": "#/$defs/ParallelNode",
          "reduce": "#/$defs/ReduceNode",
          "router": "#/$defs/RouterNode",
          "sequence": "#/$defs/SequenceNode",
          "tool": "#/$defs/ToolNode"
        },
        "propertyName": "type"
      },
      "oneOf": [
        {
          "$ref": "#/$defs/AgentNode"
        },
        {
          "$ref": "#/$defs/ToolNode"
        },
        {
          "$ref": "#/$defs/GateNode"
        },
        {
          "$ref": "#/$defs/SequenceNode"
        },
        {
          "$ref": "#/$defs/LoopNode"
        },
        {
          "$ref": "#/$defs/MapNode"
        },
        {
          "$ref": "#/$defs/ReduceNode"
        },
        {
          "$ref": "#/$defs/ParallelNode"
        },
        {
          "$ref": "#/$defs/RouterNode"
        }
      ],
      "title": "Root"
    },
    "spec_version": {
      "const": "0",
      "title": "Spec Version",
      "type": "string"
    }
  },
  "required": [
    "spec_version",
    "id",
    "name",
    "root"
  ],
  "title": "Workflow spec v0",
  "type": "object"
}
