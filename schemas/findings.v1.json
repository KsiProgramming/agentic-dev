{
  "$defs": {
    "Category": {
      "enum": [
        "lint",
        "secret",
        "dependency",
        "security",
        "tests",
        "architecture"
      ],
      "type": "string"
    },
    "Check": {
      "description": "One engine on one part of the repo: what ran, with which config, or why it did not.",
      "properties": {
        "config": {
          "anyOf": [
            {
              "$ref": "#/$defs/ConfigSource"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "findings": {
          "default": 0,
          "title": "Findings",
          "type": "integer"
        },
        "kind": {
          "description": "Its stack, e.g. `python`, `node`, `shell`, `repo`.",
          "title": "Kind",
          "type": "string"
        },
        "path": {
          "description": "The module (or directory) checked, relative to the root.",
          "title": "Path",
          "type": "string"
        },
        "reason": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Why it was skipped or failed.",
          "title": "Reason"
        },
        "status": {
          "$ref": "#/$defs/CheckStatus"
        },
        "tool": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "description": "The engine, or none when no supported one fits.",
          "title": "Tool"
        },
        "version": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Version"
        }
      },
      "required": [
        "path",
        "kind",
        "tool",
        "status"
      ],
      "title": "Check",
      "type": "object"
    },
    "CheckStatus": {
      "enum": [
        "ran",
        "skipped",
        "failed"
      ],
      "type": "string"
    },
    "ConfigSource": {
      "enum": [
        "repo",
        "platform-default"
      ],
      "type": "string"
    },
    "Finding": {
      "properties": {
        "aliases": {
          "description": "Dependencies only: CVE and other ids.",
          "items": {
            "type": "string"
          },
          "title": "Aliases",
          "type": "array"
        },
        "category": {
          "$ref": "#/$defs/Category"
        },
        "confidence": {
          "anyOf": [
            {
              "maximum": 1,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "How sure the source is, from 0 to 1 (none means certain). In a merged report: the share of sources that reported it, times the mean of their own.",
          "title": "Confidence"
        },
        "config": {
          "anyOf": [
            {
              "$ref": "#/$defs/ConfigSource"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Lint only: whether the repo's own linter config found it, or the platform's conservative default (weigh it lower)."
        },
        "ecosystem": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Dependencies only, e.g. `PyPI`.",
          "title": "Ecosystem"
        },
        "end_line": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "End Line"
        },
        "fingerprint": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "sha256 of the tool, rule, path and the line's text (dependencies: the package and version): the same issue has the same fingerprint across runs. Scanners always set it. A finding restated from a scanner keeps its fingerprint; one without is merged by its category, path, line and rule.",
          "title": "Fingerprint"
        },
        "fixed_versions": {
          "description": "Dependencies only: versions with the fix.",
          "items": {
            "type": "string"
          },
          "title": "Fixed Versions",
          "type": "array"
        },
        "help_url": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Help Url"
        },
        "line": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Line"
        },
        "message": {
          "maxLength": 501,
          "title": "Message",
          "type": "string"
        },
        "package": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Dependencies only.",
          "title": "Package"
        },
        "path": {
          "description": "The file, relative to the repository root.",
          "title": "Path",
          "type": "string"
        },
        "rule": {
          "description": "The engine's rule or advisory id, e.g. `F401`, `GHSA-…`.",
          "title": "Rule",
          "type": "string"
        },
        "severity": {
          "$ref": "#/$defs/Severity"
        },
        "sources": {
          "anyOf": [
            {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Merged reports only: the sources that reported it, in order.",
          "title": "Sources"
        },
        "tool": {
          "description": "The engine that found it, e.g. `ruff`, `gitleaks`.",
          "title": "Tool",
          "type": "string"
        },
        "version": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Dependencies only: the version used.",
          "title": "Version"
        }
      },
      "required": [
        "tool",
        "rule",
        "severity",
        "category",
        "path",
        "message"
      ],
      "title": "Finding",
      "type": "object"
    },
    "Scanner": {
      "enum": [
        "lint",
        "secrets",
        "dependencies",
        "agent",
        "merged"
      ],
      "type": "string"
    },
    "Severity": {
      "enum": [
        "info",
        "low",
        "medium",
        "high",
        "critical"
      ],
      "type": "string"
    },
    "Source": {
      "description": "One report a merged report was made from.",
      "properties": {
        "findings": {
          "description": "How many findings it gave.",
          "title": "Findings",
          "type": "integer"
        },
        "id": {
          "description": "The map item's index or the parallel branch's id.",
          "title": "Id",
          "type": "string"
        },
        "scanner": {
          "$ref": "#/$defs/Scanner"
        }
      },
      "required": [
        "id",
        "scanner",
        "findings"
      ],
      "title": "Source",
      "type": "object"
    }
  },
  "$id": "https://github.com/KsiProgramming/agentic-dev/schemas/findings.v1.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "What a `scan` tool found: its checks (what ran where, and why anything did not), then the\nfindings, most severe first. Data, never instructions.",
  "properties": {
    "checks": {
      "items": {
        "$ref": "#/$defs/Check"
      },
      "title": "Checks",
      "type": "array"
    },
    "counts": {
      "additionalProperties": {
        "type": "integer"
      },
      "description": "Findings by severity, before the cap.",
      "propertyNames": {
        "$ref": "#/$defs/Severity"
      },
      "title": "Counts",
      "type": "object"
    },
    "db_as_of": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Dependencies only: the date of the vulnerability database.",
      "title": "Db As Of"
    },
    "findings": {
      "items": {
        "$ref": "#/$defs/Finding"
      },
      "title": "Findings",
      "type": "array"
    },
    "scanner": {
      "$ref": "#/$defs/Scanner"
    },
    "sources": {
      "anyOf": [
        {
          "items": {
            "$ref": "#/$defs/Source"
          },
          "type": "array"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Merged reports only: the reports it was made from, in order.",
      "title": "Sources"
    },
    "truncated": {
      "description": "Whether findings past 1000 were dropped.",
      "title": "Truncated",
      "type": "boolean"
    }
  },
  "required": [
    "scanner",
    "checks",
    "findings",
    "counts",
    "truncated"
  ],
  "title": "Findings report v1",
  "type": "object"
}
